# TetusManager backend - ambiente local
PORT=3001
NODE_ENV=development

# Frontend Vite local
FRONTEND_URL=http://localhost:5173

# PostgreSQL local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tetusmanager
DB_USER=postgres
DB_PASSWORD=COLOQUE_SUA_SENHA_DO_POSTGRES_AQUI
DB_SSL=false

# Alternativa: se usar DATABASE_URL, ela tem prioridade sobre DB_HOST/DB_PORT/etc.
# DATABASE_URL=postgresql://postgres:SENHA@localhost:5432/tetusmanager

# JWT
JWT_SECRET=tetusmanager-local-dev-secret-change-me
JWT_EXPIRES_IN=8h
